{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PyKaraoke NG",
  "version": "0.8.0",
  "identifier": "com.pykaraoke.ng",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "python ../../../scripts/serve-web.py 18000",
    "devUrl": "http://localhost:18000",
    "frontendDist": "../../../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PyKaraoke NG",
        "width": 380,
        "height": 800,
        "minWidth": 300,
        "maxWidth": 450,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}